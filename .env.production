# 生产环境配置示例
# 复制此文件为 .env 并填入实际的API密钥

# DeepSeek API配置
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-R1

# 嵌入模型配置
EMBED_MODEL_TYPE=huggingface
EMBED_MODEL_NAME=BAAI/bge-small-zh-v1.5

# 数据目录配置
PAPER_DATABASE_ROOT=/data/sweetseek/SweetSeek_paper_database
PERSIST_DIR=./chroma_db
OUTPUT_DIR=./rag_outputs

# 服务器配置（生产环境）
HOST=0.0.0.0
PORT=8080
DEBUG=False

# HuggingFace配置
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# QA / RAG 全局参数（sweet + dual）
QA_MAX_TOKENS=1800
RETRIEVAL_TARGET_MIN=20
RETRIEVAL_TARGET_MAX=50
RETRIEVAL_MIN_THRESHOLD=0.10
RETRIEVAL_THRESHOLD_STEP=0.03
RETRIEVAL_MAX_TOP_K=260
RETRIEVAL_HARD_TOPK=400
RETRIEVAL_MAX_CHUNKS_PER_PAPER=2
RAG_CONTEXT_WINDOW=18000

# dual-protein 接口默认检索参数
DUAL_RAG_SIMILARITY_THRESHOLD=0.15
DUAL_RAG_MAX_RESULTS=200
