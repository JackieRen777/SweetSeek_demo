[Unit]
Description=SweetSeek single-concurrency docking worker
After=network.target sweetseek.service
Requires=sweetseek.service

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/sweetseek/current
EnvironmentFile=/www/sweetseek/shared/config/release.env
Environment=PATH=/www/sweetseek/current/.venv-docking/bin:/usr/local/bin:/usr/bin:/bin
Environment=DOCKING_DATA_DIR=/www/sweetseek/shared/docking
Environment=DOCKING_VENV=/www/sweetseek/current/.venv-docking
Environment=DOCKING_RUNNER=/www/sweetseek/current/scripts/docking/run_docking.sh
Environment=DOCKING_RETENTION_HOURS=24
Environment=DOCKING_MAX_DATA_BYTES=2147483648
Environment=DOCKING_MIN_FREE_BYTES=536870912
Environment=DOCKING_MIN_AVAILABLE_MB=1200
Environment=DOCKING_MAX_LOAD_1=1.2
Environment=DOCKING_VINA_TIMEOUT_SECONDS=1800
Environment=DOCKING_LIGHTDOCK_TIMEOUT_SECONDS=3600
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=/www/sweetseek/current/venv/bin/python -m services.docking_worker
Restart=always
RestartSec=5
Nice=10
CPUQuota=90%
MemoryHigh=900M
MemoryMax=1200M
MemorySwapMax=1500M
IOWeight=50
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/www/sweetseek/shared/docking

[Install]
WantedBy=multi-user.target
