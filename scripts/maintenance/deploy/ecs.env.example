#!/usr/bin/env bash
# 复制为 ecs.env 后按需修改

# ECS connection information
SERVER_IP="replace-with-server-ip"
SERVER_USER="replace-with-ssh-user"
SERVER_PORT="22"

# Stable versioned release root and the existing data/code root.
REMOTE_BASE="/www/sweetseek"
LEGACY_ROOT="/www/wwwroot/FCN_SweetSeek"

# 论文数据库独立于代码发布目录
PAPER_DATABASE_ROOT="/data/sweetseek/SweetSeek_paper_database"

# 域名
DOMAIN="replace-with-domain"

# Python 可执行文件（服务器上）
PYTHON_BIN="python3"

# Gate 2 requires real, small smoke fixtures. The flexible residue must exist
# in the receptor and use CHAIN:NUMBER notation.
DOCKING_SMOKE_RECEPTOR="/absolute/local/path/receptor.pdb"
DOCKING_SMOKE_LIGAND="/absolute/local/path/ligand.mol2"
DOCKING_SMOKE_PARTNER="/absolute/local/path/partner.pdb"
DOCKING_SMOKE_FLEX_RESIDUES="A:42"
