# Copy to .env.production only when a production-specific local profile is needed.
# Runtime secrets belong in the server's untracked .env file.
DEEPSEEK_API_KEY=replace-with-secret
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

PAPER_DATABASE_ROOT=/data/sweetseek/SweetSeek_paper_database
PERSIST_DIR=/data/sweetseek/indexes/sweetness
OUTPUT_DIR=/data/sweetseek/outputs

HOST=127.0.0.1
PORT=5001
DEBUG=false

EMBED_MODEL_TYPE=modelscope
EMBED_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBED_DISABLE_TORCH_DYNAMO=true
HF_HUB_OFFLINE=false
TRANSFORMERS_OFFLINE=false

QA_MAX_TOKENS=900
RETRIEVAL_TARGET_MIN=15
RETRIEVAL_TARGET_MAX=30
RETRIEVAL_MIN_THRESHOLD=0.10
RETRIEVAL_THRESHOLD_STEP=0.03
RETRIEVAL_MAX_TOP_K=120
RETRIEVAL_HARD_TOPK=200
RETRIEVAL_MAX_CHUNKS_PER_PAPER=2
RAG_CONTEXT_WINDOW=9000

DUAL_RAG_SIMILARITY_THRESHOLD=0.15
DUAL_RAG_MAX_RESULTS=260
